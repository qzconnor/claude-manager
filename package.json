{
  "name": "claude-manager",
  "productName": "Claude Manager",
  "version": "0.1.0",
  "description": "Manage multiple Claude Code terminals, accounts, sessions and usage in one place.",
  "author": "Connor Breuer",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:launcher": "node scripts/build-launcher.mjs",
    "build:win": "npm run build && npm run build:launcher && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "koffi": "^3.3.4",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vueuse/core": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "markdown-it": "^15.0.3",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "shadcn-vue": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.13"
  }
}
